{
  "name": "cet-prep",
  "productName": "CET备考助手",
  "version": "2.0.0",
  "description": "本地英语四六级备考软件：单词记忆、真题练习、听力训练、模拟考试、AI 阅读助手",
  "main": "electron/main.cjs",
  "private": true,
  "author": "CET Prep",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dev:electron:soft": "wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/launch-electron.mjs --soft .",
    "dev:soft": "concurrently -k \"npm:dev:web\" \"npm:dev:electron:soft\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "start:soft": "node scripts/launch-electron.mjs --soft .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.cetprep.app",
    "productName": "CET备考助手",
    "artifactName": "CET.Setup.${version}.exe",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "packaging"
    },
    "icon": "build/icon.png",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
