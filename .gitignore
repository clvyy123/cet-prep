# ===== 大文件（超过 GitHub 100MB 限制的打包产物）=====
CET备考助手.exe
resources/app.asar
*.exe.bak

# ===== 工作目录 / 系统文件 =====
.workbuddy/
Thumbs.db
Desktop.ini
.DS_Store

# ===== 日志与临时文件 =====
*.log
*.tmp
*.bak

# ===== 凭据与环境变量（防止敏感信息泄露）=====
.env
.env.*
*.pem
*.key
*.pfx
*.p12

# ===== Node.js（如后续加入源码开发）=====
node_modules/
npm-debug.log*
yarn-error.log*

# ===== 打包输出目录（如后续加入源码开发）=====
dist/
release/
build/output/
